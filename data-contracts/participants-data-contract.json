{
  "dataset": "contact_center",
  "tablename": "participants",
  "description": "One row per person or bot in a conversation. Points to customers or agents depending on the role",
  "change_data_capture": {
    "cdc_type": "upsert"
  },
  "lf_tags": {
    "privacy": "non-PII",
    "confidentiality": "internal"
  },
  "columns": [
    {
      "name": "participant_id",
      "type": "string",
      "nullable": false,
      "primary_key": true,
      "partition": null,
      "description": "Connect participant ID",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "conversation_id",
      "type": "string",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "FK -> conversations.conversation_id",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "participant_role",
      "type": "string",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "CUSTOMER, AGENT, SUPERVISOR, CUSTOM_BOT, SYSTEM",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "customer_id",
      "type": "string",
      "nullable": true,
      "primary_key": false,
      "partition": null,
      "description": "Set only when role = CUSTOMER, FK -> customers.customer_id",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "agent_id",
      "type": "string",
      "nullable": true,
      "primary_key": false,
      "partition": null,
      "description": "Set only when role = AGENT / SUPERVISOR, FK -> agents.agent_id",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "display_name",
      "type": "string",
      "nullable": true,
      "primary_key": false,
      "partition": null,
      "description": "Name shown in the chat window",
      "lf_tags": {
        "privacy": "PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "joined_at",
      "type": "timestamp",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "When the participant joined (UTC)",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "left_at",
      "type": "timestamp",
      "nullable": true,
      "primary_key": false,
      "partition": null,
      "description": "When the participant left (UTC)",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "updated_on",
      "type": "timestamp",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "Last change in the source (UTC), used for CDC",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    }
  ]
}
