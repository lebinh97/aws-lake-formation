{
  "dataset": "contact_center",
  "tablename": "messages",
  "description": "One row per chat transcript item",
  "change_data_capture": {
    "cdc_type": "upsert"
  },
  "lf_tags": {
    "privacy": "non-PII",
    "confidentiality": "internal"
  },
  "columns": [
    {
      "name": "message_id",
      "type": "string",
      "nullable": false,
      "primary_key": true,
      "partition": null,
      "description": "Transcript item ID",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "conversation_id",
      "type": "string",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "FK -> conversations.conversation_id",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "participant_id",
      "type": "string",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "Sender, FK -> participants.participant_id",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "message_type",
      "type": "string",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "MESSAGE, EVENT, ATTACHMENT",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "content_type",
      "type": "string",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "text/plain, text/markdown, application/vnd.amazonaws.connect.event.*",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "content",
      "type": "string",
      "nullable": true,
      "primary_key": false,
      "partition": null,
      "description": "Message text, always treated as PII because free text can hold phone numbers, addresses, etc.",
      "lf_tags": {
        "privacy": "PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "attachment_name",
      "type": "string",
      "nullable": true,
      "primary_key": false,
      "partition": null,
      "description": "File name, null unless ATTACHMENT",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "attachment_s3_uri",
      "type": "string",
      "nullable": true,
      "primary_key": false,
      "partition": null,
      "description": "Where the file is stored, null unless ATTACHMENT",
      "lf_tags": {
        "privacy": "PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "sent_at",
      "type": "timestamp",
      "nullable": false,
      "primary_key": false,
      "partition": "day",
      "description": "When the message was sent (UTC)",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    },
    {
      "name": "updated_on",
      "type": "timestamp",
      "nullable": false,
      "primary_key": false,
      "partition": null,
      "description": "Last change in the source (UTC), used for CDC",
      "lf_tags": {
        "privacy": "non-PII",
        "confidentiality": "internal"
      },
      "dq_rules": null
    }
  ]
}
